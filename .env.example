# Copy to `.env` and adjust. Load with e.g. `set -a; source .env; set +a`.

# Root directory containing the LMDB datasets. The loader reads
# ${DATA_ROOT}/lmdb/<split>/*.lmdb  (see DATA.md).
DATA_ROOT=./data

# Directory holding the pretrained checkpoints, with per-stream subfolders:
#   ${SIGNSPARK_CKPT_DIR}/{hand,body,face}/ema_0.9999_200000.pt
SIGNSPARK_CKPT_DIR=./checkpoints

# Where training runs / samples are written.
OUTPUT_DIR=./outputs

# ---- Weights & Biases (optional; logging is disabled by default) ----
# Set WANDB_MODE=online to enable, and provide your own project/entity.
WANDB_MODE=disabled
# WANDB_PROJECT=SignSparK
# WANDB_ENTITY=your-entity
